  "dataform_assertions_reference": [
    "SELECT\n  order_id,\n  status,\n  is_realized_revenue\nFROM\n  `apex-activewear.silver_layer.stg_order_items`\nWHERE\n  is_realized_revenue = TRUE\n  AND status NOT IN ('Complete',\n    'Shipped',\n    'Processing')",
    "SELECT\n  order_id,\n  created_at,\n  shipped_at,\n  delivered_at,\n  returned_at\nFROM\n  `apex-activewear.apex_activewear_bronze.order_items`\nWHERE\n  (shipped_at IS NOT NULL\n    AND shipped_at < created_at)\n  OR (delivered_at IS NOT NULL\n    AND delivered_at < shipped_at)",
    "WITH source_revenue AS (\n  SELECT\n    map.traffic_source,\n    SUM(oi.sale_price) AS total_revenue\n  FROM \n    `apex-activewear.silver_layer.stg_order_items` AS oi\n  JOIN \n    `apex-activewear.silver_layer.int_order_attribution` AS map\n    ON oi.order_id = map.order_id\n  GROUP BY 1\n),\nshare_calc AS (\n  SELECT\n    traffic_source,\n    100.0 * total_revenue / SUM(total_revenue) OVER() AS share_pct\n  FROM \n    source_revenue\n)\n\nSELECT * FROM share_calc \nWHERE traffic_source = 'Direct' AND share_pct > 20",
    "SELECT\n  oe.user_id,\n  ur.created_at AS user_signup,\n  oe.created_at AS event_time\nFROM\n  `apex-activewear.silver_layer.stg_users` AS ur\nJOIN\n  `apex-activewear.silver_layer.stg_online_events` AS oe\nUSING\n  (user_id)\nWHERE\n  oe.created_at < ur.created_at",
    "SELECT\n  order_id,\n  sale_price\nFROM\n  `apex-activewear.silver_layer.stg_order_items`\nWHERE\n  sale_price < 0\n  OR sale_price IS NULL"
  ],
